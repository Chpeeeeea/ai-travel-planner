# Copy to /etc/ai-travel-planner/worker.env and set mode 0600.
PLANNER_BASE_URL=https://qingtian-ai-travel.amandeepchenisekyana.chatgpt.site
PLANNING_RUN_WRITE_TOKEN=replace-with-the-same-secret-configured-in-sites
CODEX_EXECUTABLE=/usr/local/bin/codex
RESEARCH_WORKER_ID=aliyun-2c2g-01
RESEARCH_WORKER_LEASE_SECONDS=900
RESEARCH_WORKER_POLL_SECONDS=15
RESEARCH_WORKER_CONCURRENCY=1
RESEARCH_WORKER_MAX_LANE_ATTEMPTS=3

# Optional only when the service uses API-key authentication for Codex.
# Prefer storing this in a separate root-owned EnvironmentFile.
# CODEX_API_KEY=
